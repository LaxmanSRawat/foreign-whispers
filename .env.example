# Host user — so Docker-created files are owned by you, not root
# Run: id -u && id -g   to find your values
UID=1000
GID=1000

# Hugging Face — required for speaker diarization (pyannote.audio)
# Get yours at https://huggingface.co/settings/tokens
FW_HF_TOKEN=

# Logfire — optional, enables observability traces
# Get yours at https://logfire.pydantic.dev
FW_LOGFIRE_WRITE_TOKEN=

# ── Inference backend selection ───────────────────────────────────────────
# "remote" = delegate to the speaches / chatterbox Docker containers (default
#             when running via docker-compose; set automatically by compose).
# "local"  = run models in-process inside the API container (no sidecar needed,
#             but the API image must have the ML deps installed).
# FW_WHISPER_BACKEND=remote
# FW_TTS_BACKEND=remote

# ── Remote service URLs (used when backend = "remote") ───────────────────
# These are set automatically by docker-compose via service hostnames.
# Override only if you run the services on non-default ports or hosts.
# FW_WHISPER_API_URL=http://localhost:8000
# FW_CHATTERBOX_API_URL=http://localhost:8020

# ── TTS HTTP read timeout (seconds) ──────────────────────────────────────
# Per-request timeout when calling Chatterbox. CPU synthesis is slow —
# a single short Spanish sentence takes ~80 s on CPU, so 60 s would time
# out most segments and fill the output with silence. Default 600 s is
# generous enough for CPU; GPU users can lower to 60.
# FW_TTS_HTTP_TIMEOUT=600

# ── TTS voice consistency ─────────────────────────────────────────────────
# Synthesize one short "warmup" phrase per distinct speaker voice before the
# main synthesis loop. The warmup output becomes the cloning reference for all
# real segments of that speaker, anchoring voice timbre across calls and
# eliminating inter-segment drift from Chatterbox's stochastic sampling.
# Set to "off" for A/B comparison against the raw reference WAV behaviour.
# FW_TTS_WARMUP=on
#
# Sampling temperature passed to Chatterbox on every synthesis call.
# API range: 0.05–5.0. Lower values reduce per-call stochastic variation;
# there is no seed parameter so temperature is the only available lever.
# FW_TTS_TEMPERATURE=0.05

# ── Dev affordance: truncate downloads to first N seconds ────────────────
# When set to a positive integer, the download stage fetches only the
# first N seconds of every YouTube video. Useful for fast TTS iteration
# on CPU (90 s of audio → ~10 min of TTS instead of ~75 min for the full
# clip). Leave unset / empty / 0 for normal full-length downloads.
# FW_DOWNLOAD_DURATION_SECONDS=90
