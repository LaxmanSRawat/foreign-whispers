# Host user — so Docker-created files are owned by you, not root
# Run: id -u && id -g   to find your values
UID=1000
GID=1000

# Hugging Face — required for speaker diarization (pyannote.audio)
# Get yours at https://huggingface.co/settings/tokens
FW_HF_TOKEN=

# Logfire — optional, enables observability traces
# Get yours at https://logfire.pydantic.dev
FW_LOGFIRE_WRITE_TOKEN=

# ── Inference backend selection ───────────────────────────────────────────
# "remote" = delegate to the speaches / chatterbox Docker containers (default
#             when running via docker-compose; set automatically by compose).
# "local"  = run models in-process inside the API container (no sidecar needed,
#             but the API image must have the ML deps installed).
# FW_WHISPER_BACKEND=remote
# FW_TTS_BACKEND=remote

# ── Remote service URLs (used when backend = "remote") ───────────────────
# These are set automatically by docker-compose via service hostnames.
# Override only if you run the services on non-default ports or hosts.
# FW_WHISPER_API_URL=http://localhost:8000
# FW_CHATTERBOX_API_URL=http://localhost:8020
